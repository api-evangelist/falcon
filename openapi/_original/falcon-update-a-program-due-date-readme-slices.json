[
 {
  "page": "https://docs.falconfs.com/reference/update-program-due-date.md",
  "definition": {
   "openapi": "3.0.1",
   "info": {
    "title": "Update a Program Due Date",
    "description": "Use this endpoint to update a due date of a program.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1/"
    }
   ],
   "paths": {
    "/programs/{programId}/due-dates/{dueDateId}": {
     "patch": {
      "summary": "Update a Program Due Date",
      "description": "Use this endpoint to update a due date of a program.",
      "operationId": "update-duedate",
      "parameters": [
       {
        "name": "programId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The unique identifier for the credit card program."
        },
        "example": "021239f1-9bbf-4919-bf8b-22aa48127e68"
       },
       {
        "name": "dueDateId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "integer",
         "description": "The unique identifier for the due date."
        },
        "example": 31653
       },
       {
        "in": "header",
        "name": "x-tenant-id",
        "schema": {
         "type": "string"
        },
        "required": true,
        "example": "falcon"
       },
       {
        "in": "header",
        "name": "Authorization",
        "schema": {
         "type": "string"
        },
        "required": true,
        "example": "Bearer {access_token}"
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "active",
           "gracePeriodDays"
          ],
          "properties": {
           "active": {
            "type": "boolean",
            "description": "Indicates if the due date is active.",
            "enum": [
             true,
             false
            ],
            "example": true
           },
           "gracePeriodDays": {
            "type": "integer",
            "description": "Number of grace period days.",
            "example": 5
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "example": {}
          }
         }
        }
       },
       "400": {
        "description": "Invalid request parameters."
       },
       "401": {
        "description": "Unauthorized access."
       },
       "404": {
        "description": "Program or due date not found."
       },
       "500": {
        "description": "Internal server error."
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
    "buffer": {
     "0": 103,
     "1": 233,
