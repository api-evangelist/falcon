    }
   }
  }
 },
 {
  "page": "https://docs.falconfs.com/reference/post-accrued-interest.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Interest APIs",
    "description": "APIs to manage and retrieve interest-related data for credit card accounts.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/interest": {
     "post": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "Post an Accrued Interest",
      "description": "Use this endpoint to post the accrued interest to an account.",
      "operationId": "post-accrued-interest",
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "accountId"
          ],
          "properties": {
           "accountId": {
            "type": "string",
            "description": "The ID of the account to which the interest is posted.",
            "example": "1234567890"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "interestAmount": {
             "type": "string",
             "description": "The total interest amount posted to the account.",
             "example": "100.00"
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
   "components": {
    "securitySchemes": {
     "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
     }
    }
   },
   "x-readme": {
