[
 {
  "page": "https://docs.falconfs.com/reference/add-dispute.md",
  "definition": {
   "openapi": "3.0.1",
   "info": {
    "title": "Dispute APIs",
    "description": "APIs for managing transaction disputes in the credit card lifecycle.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/dispute": {
     "post": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "Add a Dispute",
      "description": "Use this endpoint to raise dispute for a given user transaction.",
      "operationId": "add-dispute",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       },
       {
        "name": "userId",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "description": "User ID of the person raising the dispute.",
         "example": "user123"
        }
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "accountId",
           "maskedCardNumber",
           "amount",
           "reason",
           "transactionId",
           "disputeType"
          ],
          "properties": {
           "accountId": {
            "type": "integer",
            "description": "Account ID of the user.",
            "example": 123456
           },
           "maskedCardNumber": {
            "type": "string",
            "description": "Masked card number of the user.",
            "example": "XXXX-XXXX-XXXX-1234"
           },
           "amount": {
            "type": "number",
            "description": "Amount involved in the dispute.",
            "example": 100
           },
           "reason": {
            "type": "string",
            "description": "Reason for the dispute.",
            "example": "Unauthorized transaction"
           },
           "description": {
            "type": "string",
            "description": "Detailed description of the dispute.",
            "example": "Transaction was not authorized by the user."
           },
           "transactionId": {
            "type": "string",
            "description": "Transaction ID of the disputed transaction.",
            "example": "txn_123456789"
           },
           "disputeType": {
            "type": "string",
            "description": "Type of dispute.",
            "example": "Fraudulent transaction"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "disputeId": {
             "type": "integer",
             "description": "Unique identifier for the dispute.",
             "example": 987654
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
