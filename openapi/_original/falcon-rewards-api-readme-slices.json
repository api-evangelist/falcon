[
 {
  "page": "https://docs.falconfs.com/reference/view-reward-point-balance.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Rewards API",
    "description": "APIs to manage reward points in a credit card lifecycle",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/reward/balance/{accountID}": {
     "get": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "View Reward Point Balance",
      "description": "Use this endpoint to fetch reward point balance for an account.",
      "operationId": "get-reward-point-balance",
      "parameters": [
       {
        "name": "accountID",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The account ID for which to fetch the reward point balance.",
         "example": "1234567890"
        }
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "accountId": {
             "type": "string",
             "description": "The account ID for which the reward point balance is fetched.",
             "example": "1234567890"
            },
            "rewardPointBalance": {
             "type": "integer",
             "description": "The total reward point balance for the account.",
             "example": 1000
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
