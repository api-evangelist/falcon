 {
  "page": "https://docs.falconfs.com/reference/view-reward-point-details.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Rewards API",
    "description": "APIs to manage reward points in a credit card lifecycle",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/reward/detail": {
     "get": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "View Reward Point Details",
      "description": "Use this endpoint to fetch reward point details for an account.",
      "operationId": "get-reward-point-details",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       },
       {
        "name": "accountID",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The account ID for which to fetch the reward point details.",
         "example": "1234567890"
        }
       },
       {
        "name": "startDate",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The start date for the reward point details.",
         "example": "2023-01-01T00:00:00Z"
        }
       },
       {
        "name": "endDate",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The end date for the reward point details.",
         "example": "2023-12-31T23:59:59Z"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "description": "Reward point details for the specified account.",
           "properties": {
            "accountId": {
             "type": "string",
             "description": "The account ID for which the reward point details are fetched.",
             "example": "1234567890"
            },
            "rewardPointDetail": {
             "type": "array",
             "description": "List of reward point transactions.",
             "items": {
              "type": "object",
              "properties": {
               "transactionAmount": {
                "type": "number",
                "description": "The amount of the transaction.",
                "example": 100
               },
               "merchantName": {
                "type": "string",
                "description": "The name of the merchant where the transaction occurred.",
                "example": "Amazon"
               },
               "transactionDate": {
                "type": "string",
                "description": "The date of the transaction.",
                "example": "2023-01-01T00:00:00Z"
               },
               "rewardCategory": {
                "type": "string",
                "description": "The category of the reward.",
                "example": "Shopping"
               },
               "normalRewardPoints": {
                "type": "integer",
                "description": "The normal reward points earned from the transaction.",
                "example": 10
               },
               "acceleratedRewardPoints": {
                "type": "integer",
                "description": "The accelerated reward points earned from the transaction.",
                "example": 5
               }
              }
             }
            },
            "totalRewardCount": {
             "type": "integer",
             "description": "The total number of reward transactions.",
             "example": 50
            },
            "totalRewardPoints": {
             "type": "integer",
             "description": "The total reward points earned.",
             "example": 500
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
