[
 {
  "page": "https://docs.falconfs.com/reference/update-issuer.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Update an Issuer",
    "description": "Use this endpoint to update issuer details.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/issuer": {
     "patch": {
      "summary": "Update an Issuer",
      "description": "Use this endpoint to update issuer details.",
      "operationId": "update-issuer",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       }
      ],
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "registeredName",
           "contactName",
           "contactEmail",
           "contactNumber",
           "supportEmail",
           "supportNumber"
          ],
          "properties": {
           "productCategories": {
            "type": "string",
            "description": "The card category.",
            "example": "Credit"
           },
           "registeredName": {
            "type": "string",
            "description": "The issuer registered name.",
            "example": "Shivalik Small Finance Bank"
           },
           "brandName": {
            "type": "string",
            "description": "The issuer brand name you want to add.",
            "example": "Shivalik Small Finance Bank"
           },
           "brandLogo": {
            "type": "string",
            "description": "The issuer logo.",
            "example": "ssfb.png"
           },
           "address": {
            "type": "string",
            "description": "The complete address of the issuer.",
            "example": "6th Floor Infotech Tower Greater Noida"
           },
           "country": {
            "type": "string",
            "description": "The issuer country.",
            "example": "India"
           },
           "website": {
            "type": "string",
            "description": "The issuer website.",
            "format": "uri",
            "example": "https://shivalikbank.com/"
           },
           "title": {
            "type": "string",
            "description": "The title of the administrator/POC of the issuer.",
            "example": "Mr."
           },
           "personalDetails": {
            "type": "object",
            "description": "The personal details.",
            "properties": {
             "contactName": {
              "type": "string",
              "description": "The name of the administrator/POC of the issuer.",
              "example": "Keshav"
             },
             "contactEmail": {
              "type": "string",
              "description": "The contact email of the administrator/POC of the issuer.",
              "format": "email",
              "example": "keshav@shivalikb.com"
             },
             "contactNumber": {
              "type": "string",
              "description": "The contact number of the administrator/POC of the issuer.",
              "example": "9871323241"
             },
             "supportEmail": {
              "type": "string",
              "description": "The support email ID of the issuer.",
              "format": "email",
              "example": "support@shivalikb.com"
             },
             "supportNumber": {
              "type": "string",
              "description": "The support contact number of the issuer.",
              "example": "01206756543"
             }
            }
           },
           "agreement": {
            "type": "string",
            "description": "The duly signed agreement file.",
            "example": "ShivalikSOP.pdf"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      }
     }
    }
   },
   "components": {
    "securitySchemes": {
     "bearerAuth": {
      "type": "http",
      "scheme": "bearer"
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
    "buffer": {
     "0": 104,
     "1": 72,
     "2": 7,
     "3": 121,
     "4": 251,
     "5": 231,
     "6": 120,
     "7": 0,
     "8": 16,
     "9": 126,
     "10": 82,
     "11": 105
    }
   }
  }
 }
]