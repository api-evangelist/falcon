[
 {
  "page": "https://docs.falconfs.com/reference/view-program-details.md",
  "definition": {
   "openapi": "3.0.3",
   "info": {
    "title": "View a Program",
    "description": "Use this endpoint to fetch details of a program.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/program/{programId}": {
     "get": {
      "summary": "View a Program",
      "description": "Use this endpoint to fetch details of a program.",
      "operationId": "view-program-details",
      "parameters": [
       {
        "name": "programId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string",
         "example": "SFCC01",
         "description": "The unique ID of the program you want to see the details."
        }
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "programeID": {
             "type": "string",
             "description": "The unique program ID.",
             "example": "SFCC01"
            },
            "issuerName": {
             "type": "string",
             "description": "The name of the issuer.",
             "example": "Shivalik"
            },
            "productCategories": {
             "type": "string",
             "description": "The categories of the product.",
             "example": "Credit"
            },
            "product": {
             "type": "string",
             "description": "The name of the product.",
             "example": "Commercial Credit Card"
            },
            "productVariant": {
             "type": "string",
             "description": "The variant of the product.",
             "example": "Shivalik Falcon Credit Card"
            },
            "program": {
             "type": "string",
             "description": "The name of the program.",
             "example": "Classic Credit Card"
            },
            "startDate": {
             "type": "string",
             "description": "The start date of the program.",
             "example": "2023-01-01T00:00:00.000Z"
            },
            "endDate": {
             "type": "string",
             "description": "The end date of the program.",
             "example": "2023-12-31T00:00:00.000Z"
            },
            "binValue": {
             "type": "string",
             "description": "The bin value of the program.",
             "example": 123456
            },
            "binRangeStart": {
             "type": "string",
             "description": "The start of the bin range.",
             "example": 123456
            },
            "binRangeEnd": {
             "type": "string",
             "description": "The end of the bin range.",
             "example": 123459
            },
            "countryCode": {
             "type": "string",
             "description": "The country code of the program.",
             "example": "IN"
            },
            "currencyCode": {
             "type": "string",
             "description": "The currency code of the program.",
             "example": "INR"
            },
            "timeZone": {
             "type": "string",
             "description": "The time zone of the program.",
             "example": "Asia/Kolkata"
            },
            "dueDate": {
             "type": "string",
             "description": "The due date of the program.",
             "example": "2023-01-15T00:00:00.000Z"
            },
            "duration": {
             "type": "string",
             "description": "The duration of the program.",
             "example": "12 months"
            },
            "revolvingInterestRate": {
             "type": "string",
             "description": "The revolving interest rate of the program.",
             "example": "1.5%"
            },
            "joiningFee": {
             "type": "string",
             "description": "The joining fee of the program.",
             "example": 500
            },
            "annualFee": {
             "type": "string",
             "description": "The annual fee of the program.",
             "example": 1000
            },
            "penalFee": {
             "type": "string",
             "description": "The penal fee of the program.",
             "example": 200
            },
            "penalInterestRate": {
             "type": "string",
             "description": "The penal interest rate of the program.",
             "example": "2%"
            },
            "cardReplacementFee": {
             "type": "string",
             "description": "The card replacement fee of the program.",
             "example": 300
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad request"
       },
       "401": {
        "description": "Unauthorized"
       },
       "500": {
        "description": "Internal server error"
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
    "buffer": {
     "0": 104,
     "1": 75,
     "2": 212,
     "3": 231,
     "4": 110,
     "5": 48,
     "6": 223,
     "7": 0,
     "8": 35,
     "9": 160,
     "10": 108,
     "11": 73
    }
   }
  }
 }
]