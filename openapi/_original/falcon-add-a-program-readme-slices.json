[
 {
  "page": "https://docs.falconfs.com/reference/add-program.md",
  "definition": {
   "openapi": "3.0.3",
   "info": {
    "title": "Add a Program",
    "description": "Use this endpoint to add a new program.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1/"
    }
   ],
   "paths": {
    "/program": {
     "post": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "Add a Program",
      "description": "Use this endpoint to add a new program.",
      "operationId": "add-program",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "issuerName",
           "productCategories",
           "product",
           "productVariant",
           "program",
           "startDate",
           "endDate",
           "binValue",
           "binRangeStart",
           "binRangeEnd",
           "countryCode",
           "currencyCode",
           "timeZone",
           "dueDate",
           "duration",
           "emailCongif",
           "cardFormFactor"
          ],
          "$ref": "#/components/schemas/ProductRequest"
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ProductResponse"
          }
         }
        }
       },
       "400": {
        "description": "Bad request"
       },
       "401": {
        "description": "Unauthorized"
       },
       "500": {
        "description": "Internal server error"
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "ProductRequest": {
      "type": "object",
      "properties": {
       "issuerName": {
        "type": "string",
        "description": "The name of the issuer.",
        "example": "Shivalik"
       },
       "productCategories": {
        "type": "string",
        "description": "The categories of the product.",
        "example": "Credit"
       },
       "product": {
        "type": "string",
        "description": "The name of the product.",
        "example": "Commercial Credit Card"
       },
       "productVariant": {
        "type": "string",
        "description": "The variant of the product.",
        "example": "Shivalik Falcon Credit Card"
       },
       "program": {
        "type": "string",
        "description": "The name of the program.",
        "example": "Classic Credit Card"
       },
       "startDate": {
        "type": "string",
        "description": "The start date of the program.",
        "example": "2023-01-01"
       },
       "endDate": {
        "type": "string",
        "description": "The end date of the program.",
        "example": "2023-12-31"
       },
       "binValue": {
        "type": "string",
        "description": "The bin value of the card.",
        "example": "123456"
       },
       "binRangeStart": {
        "type": "string",
        "description": "The start of the bin range.",
        "example": "123456"
       },
       "binRangeEnd": {
        "type": "string",
        "description": "The end of the bin range.",
        "example": "123459"
       },
       "countryCode": {
        "type": "string",
        "description": "The country code.",
        "example": "IN"
       },
       "currencyCode": {
        "type": "string",
        "description": "The currency code.",
        "example": "INR"
       },
       "timeZone": {
        "type": "string",
        "description": "The time zone.",
        "example": "Asia/Kolkata"
       },
       "dueDate": {
        "type": "string",
        "description": "The due date of the program.",
        "example": "2023-01-01"
       },
       "duration": {
        "type": "string",
        "description": "The duration of the program.",
        "example": "12 months"
       },
       "emailCongif": {
        "type": "string",
        "description": "The email configuration."
       },
       "cardFormFactor": {
        "type": "string",
        "description": "The form factor of the card.",
        "example": "Virtual"
       }
      }
     },
     "ProductResponse": {
      "type": "object",
      "properties": {
       "issuerName": {
        "type": "string",
        "description": "The name of the issuer.",
        "example": "Shivalik"
       },
       "productCategories": {
        "type": "string",
        "description": "The categories of the product.",
        "example": "Credit"
       },
       "product": {
        "type": "string",
        "description": "The name of the product.",
        "example": "Commercial Credit Card"
       },
       "productVariant": {
        "type": "string",
        "description": "The variant of the product.",
        "example": "Shivalik Falcon Credit Card"
       },
       "program": {
        "type": "string",
        "description": "The name of the program.",
        "example": "Classic Credit Card"
       },
       "programeID": {
        "type": "string",
        "description": "The ID of the program.",
        "example": "SFCC01"
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
    "buffer": {
     "0": 104,
     "1": 75,
     "2": 211,
     "3": 13,
     "4": 180,
     "5": 101,
     "6": 2,
     "7": 0,
     "8": 23,
     "9": 65,
     "10": 217,
     "11": 235
    }
   }
  }
 }
]