  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Fee APIs",
    "description": "APIs to manage fees and charges in the credit card lifecycle.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/account/debit": {
     "post": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "Post a Fee",
      "description": "Use this endpoint to post a fee to an account. Configured GST will be posted to the account automatically.",
      "operationId": "post-fee",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "accountId",
           "feeType",
           "amount",
           "narration"
          ],
          "properties": {
           "accountId": {
            "type": "string",
            "description": "ID of the account to be debited.",
            "example": "202000004782"
           },
           "feeType": {
            "type": "string",
            "description": "Type of fee to be debited.",
            "example": "Reward Redemption Fee"
           },
           "amount": {
            "type": "string",
            "description": "Amount to be debited.",
            "example": "200"
           },
           "narration": {
            "type": "string",
            "description": "Narration for the fee.",
            "example": "Annual fee for the card"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "example": {}
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
