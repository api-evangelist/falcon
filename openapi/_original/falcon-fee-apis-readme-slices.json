 {
  "page": "https://docs.falconfs.com/reference/add-fee-model.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Fee APIs",
    "description": "APIs to manage fees and charges in the credit card lifecycle.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/fee": {
     "post": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "Add a Fee Model",
      "description": "Use this endpoint to create a new fee model with configurations approved by issuer.",
      "operationId": "add-fee-model",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "feeModelID",
           "feeModelName",
           "cardType",
           "cardCategory",
           "cardSubCategory",
           "cardProduct",
           "cardBrand",
           "cardNetwork"
          ],
          "properties": {
           "revolvingInterestRate": {
            "type": "string",
            "description": "Revolving interest rate for the card",
            "example": "3.5%"
           },
           "joiningFee": {
            "type": "integer",
            "description": "Joining fee for the card",
            "example": 500
           },
           "annualFee": {
            "type": "integer",
            "description": "Annual fee of the card",
            "example": 1000
           },
           "penalFee": {
            "type": "integer",
            "description": "Penal fee of the card",
            "example": 200
           },
           "penalInterestRate": {
            "type": "string",
            "description": "Penal interest rate of the card",
            "example": "2.5%"
           },
           "cardReplacementFee": {
            "type": "string",
            "description": "Card replacement fee",
            "example": "100"
           },
           "cashAdvanceFee": {
            "type": "string",
            "description": "Cash advance fee",
            "example": "2%"
           },
           "cashAdvanceInterestRate": {
            "type": "string",
            "description": "Cash advance interest rate",
            "example": "3%"
           },
           "latePaymentFee": {
            "type": "string",
            "description": "Late payment fee",
            "example": "500"
           },
           "gst": {
            "type": "string",
            "description": "GST applicable on fees",
            "example": "18%"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "example": {}
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
