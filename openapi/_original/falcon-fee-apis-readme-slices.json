     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/fee/post-fee": {
     "post": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "Post a Pending Fee",
      "description": "Use this endpoint to post fee which is yet to be posted. This is only relevant for account closure purpose. Once this is posted, it should not be posted again for that reason. For example, If it is a overlimit fee which is to be charged once a month, it can only be charged in the next month if for any reason account is still not closed.",
      "operationId": "post-pending-fee",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "accountId"
          ],
          "properties": {
           "accountId": {
            "type": "string",
            "description": "ID of the account to be posted.",
            "example": "202000004782"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "feetype": {
             "type": "string",
             "description": "Type of the fee posted",
             "example": "type"
            },
            "feeamount": {
             "type": "integer",
             "description": "Amount of the posted fee",
             "example": 1000
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
