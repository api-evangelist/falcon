[
 {
  "page": "https://docs.falconfs.com/reference/view-programs-list.md",
  "definition": {
   "openapi": "3.0.3",
   "info": {
    "title": "View List of Programs",
    "description": "Use this endpoint to get a list of all programs.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1/"
    }
   ],
   "paths": {
    "/programs": {
     "get": {
      "summary": "View List of Programs",
      "description": "Use this endpoint to get a list of all programs.",
      "operationId": "view-programs",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "falcon"
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "Bearer {{access_token}}"
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ProductResponse"
          }
         }
        }
       },
       "400": {
        "description": "Bad request"
       },
       "401": {
        "description": "Unauthorized"
       },
       "500": {
        "description": "Internal server error"
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "ProductResponse": {
      "type": "object",
      "properties": {
       "issuerName": {
        "type": "string",
        "description": "The name of the issuer.",
        "example": "Shivalik"
       },
       "productCategories": {
        "type": "string",
        "description": "The category of the product.",
        "example": "Credit"
       },
       "product": {
        "type": "string",
        "description": "The name of the product.",
        "example": "Commercial Credit Card"
       },
       "productVariant": {
        "type": "string",
        "description": "The variant of the product.",
        "example": "Shivalik Falcon Credit Card"
       },
       "program": {
        "type": "string",
        "description": "The name of the program.",
        "example": "Classic Credit Card"
       },
       "programeID": {
        "type": "string",
        "description": "The unique ID of the program.",
        "example": "SFCC01"
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
