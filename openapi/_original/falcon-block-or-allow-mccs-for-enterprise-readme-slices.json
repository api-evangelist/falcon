[
 {
  "page": "https://docs.falconfs.com/reference/enterprise-program-action.md",
  "definition": {
   "openapi": "3.0.3",
   "info": {
    "title": "Block or Allow MCCs for Enterprise",
    "description": "Use this endpoint to block/allow MCCs for enterprise.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1/"
    }
   ],
   "paths": {
    "/enterprise": {
     "post": {
      "summary": "Block or Allow MCCs for Enterprise",
      "description": "Use this endpoint to block/allow MCCs for enterprise.",
      "operationId": "manageEnterpriseProgramAction",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "enterpriseId",
           "programeID",
           "action",
           "mcc"
          ],
          "$ref": "#/components/schemas/EnterpriseProgramActionRequest"
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/SuccessResponse"
          }
         }
        }
       },
       "400": {
        "description": "Bad request"
       },
       "401": {
        "description": "Unauthorized"
       },
       "500": {
        "description": "Internal server error"
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "EnterpriseProgramActionRequest": {
      "type": "object",
      "properties": {
       "enterpriseId": {
        "type": "string",
        "description": "The unique identifier for the enterprise.",
        "format": "uuid",
        "example": "8a5364cd-e606-4328-8915-2bdf31c77ebe"
       },
       "programeID": {
        "type": "string",
        "description": "The unique identifier for the program.",
        "example": "SFCC02"
       },
       "action": {
        "type": "string",
        "description": "An action to be taken on the MCC.",
        "enum": [
         "allow",
         "restrict"
        ],
        "example": "allow"
       },
       "mcc": {
        "type": "string",
        "description": "The merchant category code to be blocked or allowed.",
        "example": "5812"
       }
      }
     },
     "SuccessResponse": {
      "type": "object",
      "description": "Empty response for successful action"
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
    "buffer": {
     "0": 103,
     "1": 232,
