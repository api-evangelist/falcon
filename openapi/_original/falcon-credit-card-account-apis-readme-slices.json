   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/account": {
     "put": {
      "summary": "Update User Accounts",
      "description": "Use this endpoint to update an account's parameters like credit limit, overlimit, or billing cycle.",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "falcon"
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "Bearer {{access_token}}"
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "accountId",
           "creditLimit",
           "dueDate",
           "overLimit"
          ],
          "properties": {
           "accountId": {
            "type": "string",
            "description": "The ID of the account to be updated.",
            "example": "ACC123456"
           },
           "creditLimit": {
            "type": "string",
            "description": "The new credit limit for the account.",
            "example": "40000"
           },
           "dueDate": {
            "type": "string",
            "description": "The new due date for the account.",
            "example": "2023-10-15"
           },
           "nomineeName": {
            "type": "string",
            "description": "The name of the nominee for the account.",
            "example": "Jane Doe"
           },
           "nomineeRelationship": {
            "type": "string",
            "description": "The relationship of the nominee to the account holder.",
            "example": "Sister"
           },
           "overLimit": {
            "type": "object",
            "properties": {
             "consent": {
              "type": "boolean",
              "description": "Indicates if the user consents to over-limit transactions.",
              "example": true,
              "enum": [
               true,
               false
              ]
             },
             "consentRemarks": {
              "type": "string",
              "description": "Remarks regarding the user's consent for over-limit transactions.",
              "example": "User has agreed to over-limit transactions."
             },
             "flag": {
              "type": "boolean",
              "description": "Indicates if the account is flagged for over-limit transactions.",
              "example": true,
              "enum": [
               true,
               false
              ]
             },
             "percent": {
              "type": "integer",
              "description": "The percentage of the credit limit that can be exceeded.",
              "example": 15
             }
            }
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "example": {}
          }
         }
        }
       }
      }
     }
    }
   },
