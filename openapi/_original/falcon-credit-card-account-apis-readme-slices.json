 {
  "page": "https://docs.falconfs.com/reference/view-user-account-list.md",
  "definition": {
   "openapi": "3.0.1",
   "info": {
    "title": "Falcon Credit Card Account APIs",
    "description": "API endpoints for managing user accounts in the Falcon credit card lifecycle.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/account/users": {
     "get": {
      "summary": "View List of User Accounts",
      "description": "Use this endpoint to fetch a list of user accounts.",
      "parameters": [
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "falcon"
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "Bearer {{access_token}}"
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "userId": {
             "type": "string",
             "description": "The ID of the user whose accounts are being fetched.",
             "example": "USR123456"
            },
            "enterpriseId": {
             "type": "string",
             "description": "The ID of the enterprise associated with the user.",
             "example": "ENT123456"
            },
            "accountList": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "programID": {
                "type": "string",
                "description": "The ID of the program associated with the account.",
                "example": "SF001"
               },
               "accountId": {
                "type": "string",
                "description": "The ID of the account.",
                "example": "ACC123456"
               },
               "programName": {
                "type": "string",
                "description": "The name of the program associated with the account.",
                "example": "Super Finance Program"
               },
               "primaryCardNumberMasked": {
                "type": "string",
                "description": "The masked primary card number.",
                "example": "XXXX-XXXX-XXXX-1234"
               },
               "availableCreditLimit": {
                "type": "integer",
                "description": "The available credit limit for the account.",
                "example": 20000
               },
               "outstandingAmount": {
                "type": "integer",
                "description": "The outstanding amount on the account.",
                "example": 5000
               }
              }
             }
            },
            "totalCount": {
             "type": "integer",
             "description": "The total number of accounts associated with the user.",
             "example": 1
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
