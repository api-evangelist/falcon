[
 {
  "page": "https://docs.falconfs.com/reference/add-user-account.md",
  "definition": {
   "openapi": "3.0.1",
   "info": {
    "title": "Falcon Credit Card Account APIs",
    "description": "API endpoints for managing user accounts in the Falcon credit card lifecycle.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/user/{userId}/account": {
     "post": {
      "summary": "Add a User Account",
      "description": "Use this endpoint to create a new account for user when an user has to be added to a new program.",
      "parameters": [
       {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "falcon"
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "Bearer {{access_token}}"
       }
      ],
      "requestBody": {
       "required": true,
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "userId",
           "programId",
           "isAutoDebit",
           "autoDebitType",
           "savingsAccountNumber",
           "maxCreditLimit",
           "creditLimit",
           "enterpriseIdentifierType",
           "enterpriseIdentifierValue",
           "dueDate"
          ],
          "properties": {
           "programId": {
            "type": "string",
            "description": "The ID of the program to which the account belongs.",
            "example": "SF001"
           },
           "isAutoDebit": {
            "type": "string",
            "description": "Indicates if auto debit is enabled for the account.",
            "example": "true"
           },
           "autoDebitType": {
            "type": "string",
            "description": "The type of auto debit.",
            "example": "full",
            "enum": [
             "full",
             "partial"
            ]
           },
           "savingsAccountNumber": {
            "type": "string",
            "description": "The savings account number linked to the credit card.",
            "example": "123456789012"
           },
           "maxCreditLimit": {
            "type": "string",
            "description": "The maximum credit limit for the account.",
            "example": "50000"
           },
           "creditLimit": {
            "type": "string",
            "description": "The credit limit for the account.",
            "example": "30000"
           },
           "nomineeName": {
            "type": "string",
            "description": "The name of the nominee for the account.",
            "example": "John Doe"
           },
           "nomineeRelationship": {
            "type": "string",
            "description": "The relationship of the nominee to the account holder.",
            "example": "Brother"
           },
           "overLimit": {
            "type": "object",
            "properties": {
             "consent": {
              "type": "boolean",
              "description": "Indicates if the user consents to over-limit transactions.",
              "example": true,
              "enum": [
               "true",
               "false"
              ]
             },
             "consentRemarks": {
              "type": "string",
              "description": "Remarks regarding the user's consent for over-limit transactions.",
              "example": "User has agreed to over-limit transactions."
             },
             "flag": {
              "type": "boolean",
              "description": "Indicates if the account is flagged for over-limit transactions.",
              "example": true,
              "enum": [
               "true",
               "true"
              ]
             },
             "percent": {
              "type": "integer",
              "description": "The percentage of the credit limit that can be exceeded.",
              "example": 10
             }
            }
           },
           "branchId": {
            "type": "string",
            "description": "The ID of the branch where the account is opened.",
            "example": "BR001"
           },
           "applicationReferenceNumber": {
            "type": "string",
            "description": "The reference number for the account application.",
            "example": "APP123456"
           },
           "customInfo": {
            "type": "object",
            "properties": {
             "additionalProperties": {
              "type": "string",
              "description": "Custom information related to the account.",
              "example": "Custom data"
             }
            }
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "accountId": {
             "type": "string",
             "description": "The ID of the newly created account.",
             "example": "ACC123456"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
