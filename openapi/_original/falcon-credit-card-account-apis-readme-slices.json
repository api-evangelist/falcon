 {
  "page": "https://docs.falconfs.com/reference/view-user-account-details.md",
  "definition": {
   "openapi": "3.0.1",
   "info": {
    "title": "Falcon Credit Card Account APIs",
    "description": "API endpoints for managing user accounts in the Falcon credit card lifecycle.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/account/{accountId}": {
     "get": {
      "summary": "View User Account Details",
      "description": "Use this endpoint to fetch details of a particular user account.",
      "parameters": [
       {
        "name": "accountId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string"
        },
        "description": "The unique ID of the account.",
        "example": "ACC123456"
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "falcon"
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "Bearer {{access_token}}"
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "accountId": {
             "type": "string",
             "description": "The ID of the account.",
             "example": "ACC123456"
            },
            "status": {
             "type": "string",
             "description": "The status of the account.",
             "example": "active",
             "enum": [
              "active",
              "inactive",
              "closed"
             ]
            },
            "programID": {
             "type": "string",
             "description": "The ID of the program associated with the account.",
             "example": "SF001"
            },
            "openingDate": {
             "type": "string",
             "description": "The date the account was opened.",
             "example": "2023-01-01"
            },
            "billingCycleFrequency": {
             "type": "string",
             "description": "The frequency of the billing cycle.",
             "example": "monthly"
            },
            "linkedFormFactors": {
             "type": "string",
             "description": "The linked form factors.",
             "example": "physical",
             "enum": [
              "physical",
              "virtual"
             ]
            },
            "primaryCardId": {
             "type": "string",
             "description": "The primary card ID.",
             "example": "CARD123456"
            },
            "primaryCardNumberMasked": {
             "type": "string",
             "description": "The masked primary card number.",
             "example": "XXXX-XXXX-XXXX-1234"
            },
            "currency": {
             "type": "string",
             "description": "The currency of the account.",
             "example": "INR"
            },
            "grantedCreditLimit": {
             "type": "string",
             "description": "The granted credit limit for the account.",
             "example": "30000"
            },
            "availableCreditLimit": {
             "type": "string",
             "description": "The available credit limit for the account.",
             "example": "20000"
            },
            "outstandingAmount": {
             "type": "string",
             "description": "The outstanding amount on the account.",
             "example": "5000"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
