        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "accountId": {
             "type": "integer",
             "description": "The unique identifier of the corporate account.",
             "example": 202000004782
            },
            "statementLists": {
             "type": "array",
             "description": "List of statements for the corporate account.",
             "items": {
              "type": "object",
              "properties": {
               "statementId": {
                "type": "string",
                "description": "The unique identifier of the statement.",
                "example": "STAT1222"
               },
               "openingDate": {
                "type": "string",
                "description": "The opening date of the statement.",
                "example": "02-09-2023"
               },
               "closingDate": {
                "type": "string",
                "description": "The closing date of the statement.",
                "example": "02-10-2023"
               },
               "statementDate": {
                "type": "string",
                "description": "The date of the statement.",
                "example": "02-10-2023"
               },
               "period": {
                "type": "integer",
                "description": "The period of the statement in days.",
                "example": 31
               },
               "pdfLinkWithPassword": {
                "type": "string",
                "description": "The link to download the PDF of the statement with password.",
                "format": "uri",
                "example": "https://www.google.com/pdf_with_password"
               },
               "pdfLinkWithoutPassword": {
                "type": "string",
                "description": "The link to download the PDF of the statement without password.",
                "format": "uri",
                "example": "https://www.google.com/pdf_without_password"
               }
              }
             }
            },
            "totalCount": {
             "type": "integer",
             "description": "The total number of statements available.",
             "example": 1
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
