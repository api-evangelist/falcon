      "description": "Use this endpoint to fetch list of statements for an enterprise account.",
      "operationId": "get-enterprise-statement-list",
      "parameters": [
       {
        "name": "accountId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string"
        },
        "description": "The unique identifier for the corporate account.",
        "example": "account123"
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
