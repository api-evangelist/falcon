   "paths": {
    "/statementlist/{accountId}/user?pageOffset=2&pageSize=12'": {
     "get": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "View the User Account Statement List",
      "description": "Use this endpoint to fetch a list of statements for a user account.",
      "operationId": "get-user-statement-list",
      "parameters": [
       {
        "name": "accountId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string"
        },
        "description": "The unique identifier for the user account.",
        "example": "account123"
       },
       {
        "name": "pageOffset",
        "in": "query",
        "required": true,
        "schema": {
         "type": "integer",
         "description": "The offset for pagination.",
         "example": 2
        }
       },
       {
        "name": "pageSize",
        "in": "query",
        "required": true,
        "schema": {
         "type": "integer",
         "description": "The number of items per page.",
         "example": 12
        }
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
