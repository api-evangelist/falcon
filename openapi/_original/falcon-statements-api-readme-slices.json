    "/statement-past/user/{statementId}": {
     "get": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "View or Download Past User Account Statements",
      "description": "Use this endpoint to fetch or dowload particular statement for a user account.",
      "operationId": "get-past-user-account-statement",
      "parameters": [
       {
        "name": "statementId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string"
        },
        "description": "The unique identifier for the user account statement.",
        "example": "statement123"
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "statementId": {
             "type": "string",
             "description": "The unique identifier for the statement.",
             "example": "STAT1234"
            },
            "statementEndDate": {
             "type": "string",
             "description": "The end date of the statement period.",
             "example": "2023-10-01T00:00:00.000Z"
            },
            "dueDate": {
             "type": "string",
             "description": "The due date for payment.",
             "example": "2023-10-15T00:00:00.000Z"
            },
            "totalAmountDue": {
             "type": "string",
             "description": "The total amount due in the statement.",
             "example": 1500
            },
            "minimumAmountDue": {
             "type": "string",
             "description": "The minimum amount due in the statement.",
             "example": 500
            },
            "availableCreditLimit": {
             "type": "string",
             "description": "The available credit limit of the user account.",
             "example": 3500
            },
            "totalCreditLimit": {
             "type": "string",
             "description": "The total credit limit of the user account.",
             "example": 5000
            },
            "availableCashLimit": {
             "type": "string",
             "description": "The available cash limit of the user account.",
             "example": 2000
            },
            "totalCashLimit": {
             "type": "string",
             "description": "The total cash limit of the user account.",
             "example": 3000
            },
            "openingBalance": {
             "type": "string",
             "description": "The opening balance of the statement.",
             "example": 1000
            },
            "amountPaid": {
             "type": "string",
             "description": "The amount paid by the user.",
             "example": 500
            },
            "purchases": {
             "type": "string",
             "description": "The total purchases made during the statement period.",
             "example": 3000
            },
            "financeCharges": {
             "type": "string",
             "description": "The finance charges applied during the statement period.",
             "example": 100
            },
            "overlimitAmount": {
             "type": "string",
             "description": "The overlimit amount if applicable.",
             "example": 200
            },
            "pastDues": {
             "type": "object",
             "description": "Details of past dues.",
             "properties": {
              "OneMonthPastDue": {
               "type": "string",
               "description": "The amount past due for one month.",
               "example": 100
              },
              "TwoMonthPastDue": {
               "type": "string",
               "description": "The amount past due for two months.",
               "example": 200
              },
              "ThreeMonthPastDue": {
               "type": "string",
               "description": "The amount past due for three months.",
               "example": 300
              }
             }
            },
            "totalRewardPoints": {
             "type": "string",
             "description": "The total reward points earned during the statement period.",
             "example": 1000
            },
            "pdfLink": {
             "type": "string",
             "description": "The link to download the PDF of the statement.",
             "example": "https://example.com/statement123.pdf",
             "format": "uri"
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
