[
 {
  "page": "https://docs.falconfs.com/reference/get-credit-card-statement.md",
  "definition": {
   "openapi": "3.0.1",
   "info": {
    "title": "Statements API",
    "description": "APIs to retrieve and manage credit card statements.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/user/{bank}/{userId}/statement": {
     "get": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "Get a Credit Card Statement",
      "description": "Use this endpoint to fetch month's credit card statement for a user's credit card.",
      "operationId": "get-credit-card-statement",
      "parameters": [
       {
        "name": "bank",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The bank name associated with the credit card.",
         "example": "HDFC"
        }
       },
       {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The unique identifier for the user.",
         "example": "user123"
        }
       },
       {
        "name": "month",
        "in": "query",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The month for which the statement is requested.",
         "example": "2023-10"
        }
       },
       {
        "name": "fileType",
        "in": "query",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The type of file to be returned (PDF or CSV).",
         "example": "PDF"
        }
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "openingBalance": {
             "type": "integer",
             "description": "The opening balance for the statement period.",
             "example": 1000
            },
            "closingBalance": {
             "type": "integer",
             "description": "The closing balance for the statement period.",
             "example": 1500
            },
            "statementDate": {
             "type": "string",
             "description": "The date of the statement.",
             "example": "2023-10-01"
            },
            "dueDate": {
             "type": "string",
             "description": "The due date for payment.",
             "example": "2023-10-15"
            },
            "creditLimit": {
             "type": "integer",
             "description": "The credit limit for the card.",
             "example": 5000
            },
            "availableCredit": {
             "type": "integer",
             "description": "The available credit limit.",
             "example": 3500
            },
            "pastDueAmount": {
             "type": "integer",
             "description": "The amount past due.",
             "example": 200
            },
            "purchases": {
             "type": "integer",
             "description": "The total purchases made during the statement period.",
             "example": 3000
            },
            "transactions": {
             "type": "array",
             "description": "List of transactions made during the statement period.",
             "items": {
              "type": "object",
              "properties": {
               "transactionAmount": {
                "type": "integer",
                "description": "The amount of the transaction.",
                "example": 100
               },
               "transactionType": {
                "type": "string",
                "description": "The type of transaction.",
                "example": "purchase"
               },
               "transactionDescription": {
                "type": "string",
                "description": "The description of the transaction.",
                "example": "Grocery Store"
               }
              }
             }
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
   "components": {
    "securitySchemes": {
     "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
    "buffer": {
     "0": 103,
