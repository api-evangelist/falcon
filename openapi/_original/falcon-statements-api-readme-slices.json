 {
  "page": "https://docs.falconfs.com/reference/view-enterprise-past-statements.md",
  "definition": {
   "openapi": "3.0.1",
   "info": {
    "title": "Statements API",
    "description": "APIs to retrieve and manage credit card statements.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/statementlist/enterprise-past/{accountId}": {
     "get": {
      "security": [
       {
        "bearerAuth": []
       }
      ],
      "summary": "View or Download Past Enterprise Statements",
      "description": "Use this endpoint to fetch list of statements for a corporate account in a paginated way, starting from the latest statement.",
      "operationId": "get-enterprise-past-statements",
      "parameters": [
       {
        "name": "accountId",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string"
        },
        "description": "The unique identifier for the corporate account.",
        "example": "account123"
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "enterpriseId": {
             "type": "string",
             "description": "The unique identifier for the enterprise.",
             "example": "enterprise123"
            },
            "statementList": {
             "type": "array",
             "description": "List of statements for the corporate account.",
             "items": {
              "type": "object",
              "properties": {
               "statementId": {
                "type": "string",
                "description": "The unique identifier for the statement.",
                "example": "statement123"
               },
               "statementStartDate": {
                "type": "string",
                "description": "The start date of the statement period.",
                "example": "2023-09-01"
               },
               "statementEndDate": {
                "type": "string",
                "description": "The end date of the statement period.",
                "example": "2023-09-30"
               },
               "totalAmountDue": {
                "type": "integer",
                "description": "The total amount due of the statement.",
                "example": 2000
               },
               "minimumAmountDue": {
                "type": "integer",
                "description": "The minimum amount due of the statement.",
                "example": 500
               },
               "dueDate": {
                "type": "string",
                "description": "The due date for the statement.",
                "example": "2023-10-15"
               },
               "pdfLink": {
                "type": "string",
                "description": "The link to download the PDF of the statement.",
                "example": "https://example.com/statement123.pdf"
               }
              }
             }
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad Request"
       },
       "401": {
        "description": "Unauthorized"
       }
      }
     }
    }
   },
   "components": {
    "securitySchemes": {
     "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
     }
    }
