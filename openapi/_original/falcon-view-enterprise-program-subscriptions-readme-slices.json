[
 {
  "page": "https://docs.falconfs.com/reference/view-enterprise-program.md",
  "definition": {
   "openapi": "3.0.3",
   "info": {
    "title": "View Enterprise Program Subscriptions",
    "description": "Use this endpoint to check all the programs subscribed by an enterprise.",
    "version": "1.0.0"
   },
   "servers": [
    {
     "url": "https://stage1.tab.kitecash.in/cc-open-api/falcon/v1"
    }
   ],
   "paths": {
    "/product/{enterpriseID}": {
     "get": {
      "summary": "View Enterprise Program Subscriptions",
      "description": "Use this endpoint to check all the programs subscribed by an enterprise.",
      "operationId": "view-enterprise-program",
      "parameters": [
       {
        "name": "enterpriseID",
        "in": "path",
        "required": true,
        "schema": {
         "type": "string",
         "description": "The ID of the enterprise to retrieve product details for.",
         "example": "Wework"
        }
       },
       {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "falcon"
        }
       },
       {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
         "type": "string",
         "example": "Bearer {{access_token}}"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "ok",
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "enterpriseID": {
             "type": "string",
             "description": "The unique ID of the enterprise.",
             "example": "Wework"
            },
            "products": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "product": {
                "type": "string",
                "description": "The name of the product.",
                "example": "Commercial Credit Card"
               },
               "productVariant": {
                "type": "string",
                "description": "The variant of the product.",
                "example": "Shivalik Falcon Credit Card"
               },
               "program": {
                "type": "string",
                "description": "The name of the program.",
                "example": "Classic Credit Card"
               },
               "programeID": {
                "type": "string",
                "description": "The unique ID of the program.",
                "example": "SFCC01"
               }
              }
             }
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "Bad request"
       },
       "401": {
        "description": "Unauthorized"
       },
       "500": {
        "description": "Internal server error"
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
